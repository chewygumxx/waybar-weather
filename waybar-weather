set -euo pipefail

: "${UNITS:=metric}"
: "${LOCATION:=Melbourne}"
: "${VISUALCROSSING_APIKEY:=$(pass-cli item view 'pass://pass-cli/api_visualcrossing/APIKEY')}"

get_raw_response() {
    local encoded_location
    encoded_location="$(jq -rn --arg location "$LOCATION" '$location | @uri')"

    curl \
        --silent \
        --retry 3 \
        --retry-delay 2 \
        --show-error \
        --fail-with-body \
        --get \
        --data-urlencode 'iconSet=icons2' \
        --data-urlencode 'contentType=json' \
        --data-urlencode "unitGroup=$UNITS" \
        --data-urlencode "key=$VISUALCROSSING_APIKEY" \
        "https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline/$encoded_location"
}

map_icon() {
    local color icon
    case "$1" in
        wind)                  color='#b3deef' icon="" ;;
        fog)                   color='#b3deef' icon="" ;;
        clear-day)             color='#ffc24b' icon="" ;;
        clear-night)           color='#cad6ff' icon="" ;;
        cloudy)                color='#aaaaaa' icon="" ;;
        partly-cloudy-night)   color='#cad6ff' icon="" ;;
        partly-cloudy-day)     color='#ffc24b' icon="" ;;
        rain)                  color='#7171d3' icon="" ;;
        showers-day)           color='#73cef4' icon="" ;;
        showers-night)         color='#73cef4' icon="" ;;
        thunder-rain)          color='#f0fb3e' icon="" ;;
        thunder-showers-day)   color='#f0fb3e' icon="" ;;
        thunder-showers-night) color='#f0fb3e' icon="" ;;
        snow)                  color='#e8e0ff' icon="" ;;
        snow-showers-day)      color='#e8e0ff' icon="" ;;
        snow-showers-night)    color='#e8e0ff' icon="" ;;
        *)                     color='#f43755' icon="" ;;
    esac

    printf '<span color="%s">%s</span>' "$color" "$icon"
}

unit_symbol() {
    case "$UNITS" in
        us)     printf '°F' ;;
        metric) printf '°C' ;;
        uk)     printf '°C' ;;
        base)   printf 'K' ;;
        *)      printf '°' ;;
    esac
}

emit_error() {
    jq -nc \
        --arg text "Error $(map_icon '')" \
        --arg tooltip "$1" \
        --arg class "error" \
        '{text: $text, tooltip: $tooltip, class: $class}'
}

summarize_error() {
    local msg
    msg="$(printf '%s' "$1" | tr '\n' ' ' | cut -c1-200)"
    if [[ -z "${msg// }" ]]; then
        msg="Failed to retrieve weather for $LOCATION"
    fi
    printf '%s' "$msg"
}

main() {
    local raw_response raw_tsv conditions temp icon

    if ! raw_response="$(get_raw_response)"; then
        emit_error "$(summarize_error "$raw_response")"
        return
    fi

    if ! raw_tsv="$(printf '%s\n' "$raw_response" | jq -r '
        .currentConditions
        | if (.temp | type) != "number" then error("missing temp") else . end
        | [.conditions, (.temp | tostring), .icon]
        | @tsv
    ')"; then
        emit_error "Failed to parse weather data for $LOCATION"
        return
    fi

    IFS=$'\t' read -r conditions temp icon <<< "$raw_tsv"

    jq -nc \
        --arg conditions "$conditions" \
        --arg icon_span "$(map_icon "$icon")" \
        --arg temp "$temp" \
        --arg unit "$(unit_symbol)" \
        --arg icon "$icon" \
        '{
            text: (($conditions | @html) + " " + $icon_span + " " + $temp + $unit),
            tooltip: ($conditions | @html),
            class: $icon
        }'
}

main
